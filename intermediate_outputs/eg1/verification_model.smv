MODULE main
VAR
    global_state : {
        TransportStarted_Shipping,
        TemperatureChecked_StorageValidated,
        ShipmentApproved_DispatchAuthorized,
        Created_Initiated,
        ShipmentRejected_DispatchRejected,
        Delivered_Received
    };
    temp : 0..100;


DEFINE
    Created :=
        global_state = Created_Initiated;
    Delivered :=
        global_state = Delivered_Received;
    DispatchAuthorized :=
        global_state = ShipmentApproved_DispatchAuthorized;
    DispatchRejected :=
        global_state = ShipmentRejected_DispatchRejected;
    Initiated :=
        global_state = Created_Initiated;
    Received :=
        global_state = Delivered_Received;
    ShipmentApproved :=
        global_state = ShipmentApproved_DispatchAuthorized;
    ShipmentRejected :=
        global_state = ShipmentRejected_DispatchRejected;
    Shipping :=
        global_state = TransportStarted_Shipping;
    StorageValidated :=
        global_state = TemperatureChecked_StorageValidated;
    TemperatureChecked :=
        global_state = TemperatureChecked_StorageValidated;
    TransportStarted :=
        global_state = TransportStarted_Shipping;
ASSIGN
    init(global_state) := Created_Initiated;
    next(temp) := temp;

    next(global_state) := case

        global_state = Created_Initiated : TemperatureChecked_StorageValidated;

        global_state = TemperatureChecked_StorageValidated & ((temp >= 2 & temp <= 8)) : ShipmentApproved_DispatchAuthorized;
        global_state = TemperatureChecked_StorageValidated & ((temp < 2 | temp > 8)) : ShipmentRejected_DispatchRejected;

        global_state = ShipmentApproved_DispatchAuthorized : TransportStarted_Shipping;

        global_state = TransportStarted_Shipping : Delivered_Received;

        TRUE : global_state;
    esac;

-- ======================================
-- Verification Properties
-- ======================================

-- Synchronization

-- SYNC_1
CTLSPEC AG(global_state = Created_Initiated -> AF(global_state = TemperatureChecked_StorageValidated));

-- SYNC_2
CTLSPEC AG(global_state = TemperatureChecked_StorageValidated -> AF(global_state = ShipmentApproved_DispatchAuthorized));

-- SYNC_3
CTLSPEC AG(global_state = TemperatureChecked_StorageValidated -> AF(global_state = ShipmentRejected_DispatchRejected));

-- SYNC_4
CTLSPEC AG(global_state = ShipmentApproved_DispatchAuthorized -> AF(global_state = TransportStarted_Shipping));

-- SYNC_5
CTLSPEC AG(global_state = TransportStarted_Shipping -> AF(global_state = Delivered_Received));

-- Consistency

-- Reachability

-- REACH_TERMINAL
CTLSPEC AG(EF(global_state = ShipmentRejected_DispatchRejected | global_state = Delivered_Received));

-- Deadlock

-- DEADLOCK_SUCCESSOR
CTLSPEC AG(EX TRUE);

-- DEADLOCK_TERMINAL
CTLSPEC AG(EF(global_state = ShipmentRejected_DispatchRejected | global_state = Delivered_Received));
